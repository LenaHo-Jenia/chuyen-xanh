# Sao chép thành .env.local khi chạy trên máy, hoặc nhập vào Vercel → Settings → Environment Variables.
# Thiếu biến nào thì tính năng tương ứng tự tắt, trang vẫn chạy.

# Trợ lý AI (Google AI Studio → Get API key)
GEMINI_API_KEY=
# Tùy chọn: đổi mô hình, mặc định gemini-flash-latest
GEMINI_MODEL=

# Lưu câu hỏi và thống kê câu hỏi nổi bật (Supabase → Project Settings → API)
SUPABASE_URL=
# Dùng secret key (sb_secret_...) hoặc service_role key. TUYỆT ĐỐI không đưa lên GitHub.
SUPABASE_SECRET_KEY=

# Tùy chọn: số câu hỏi tối thiểu trong 14 ngày mới hiện thống kê, mặc định 10
TOP_QUESTIONS_MIN=
